{
  "name": "rasta",
  "version": "0.2.0",
  "description": "Crowdsourced footpath accessibility map. Walk a street with your phone, and the city gets a little more mapped.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "mock": "node scripts/mock.js",
    "test": "node --test tests/",
    "test:vision": "node test-vision.js",
    "eval": "node evals/run.js",
    "lint": "node scripts/lint.js",
    "shoot": "node scripts/shoot.js",
    "check": "node scripts/browser-check.js"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.11.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
