# Copy to .env — read only by the server process, never sent to the browser.
# Leave ANTHROPIC_API_KEY empty to run in mock vision mode (no tokens spent).
ANTHROPIC_API_KEY=

# Optional overrides — see README → Environment variables
# RASTA_MODEL=claude-fable-5-1
# RASTA_MOCK_VISION=1          # force mock vision even when a key is set
# RASTA_DB=data/rasta.db       # SQLite file path
# PORT=3000
# OSRM_BASE=https://router.project-osrm.org

# Protection (Phase 3) — all optional
# RASTA_VISION_CONCURRENCY=4        # max model calls in flight across all requests
# RASTA_DAILY_TOKEN_BUDGET=2000000  # input+output tokens per UTC day; unset = unlimited
# RASTA_RATE_LIMIT_SEGMENTS=30      # POST /api/segments per IP per window (0 disables)
# RASTA_RATE_LIMIT_ROUTE=120        # POST /api/route per IP per window (0 disables)
# RASTA_RATE_LIMIT_WINDOW_MIN=15
# RASTA_TRUST_PROXY=1               # hops to trust behind a reverse proxy
# RASTA_MAX_UPLOAD_MB=40
# RASTA_MAX_IMAGE_PX=6000
# RASTA_ADMIN_TOKEN=                # enables DELETE /api/segments/:id (Bearer token)
# RASTA_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Storage (Phase 4) — default is local disk under uploads/
# RASTA_STORAGE=s3
# RASTA_S3_BUCKET=rasta-photos
# RASTA_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS
# RASTA_S3_REGION=auto
# RASTA_S3_ACCESS_KEY_ID=
# RASTA_S3_SECRET_ACCESS_KEY=
# RASTA_S3_PREFIX=photos/
# RASTA_S3_PUBLIC_URL=https://photos.example.org               # omit to proxy through /uploads

# Routing & tiles (Phase 5) — defaults are the public demo servers: development only
# OSRM_BASE=http://localhost:5000              # self-hosted, see scripts/osrm-prepare.sh
# OSRM_TIMEOUT_MS=3000
# RASTA_TILE_URL=https://tiles.example.org/{z}/{x}/{y}.png
# RASTA_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; Example Tiles

# Logging & errors (Phase 6)
# LOG_LEVEL=info
# LOG_FORMAT=json                 # default: pretty on a TTY, json otherwise
# SENTRY_DSN=https://<key>@<host>/<project>

# Optional: Google Maps JavaScript API key (Dynamic Maps has a free monthly quota; restrict by referrer). Adds a Google basemap.
# GOOGLE_MAPS_KEY=AIza...
# Optional: alternative Overpass mirror for the OpenStreetMap import
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional: Mapillary client token (free at mapillary.com/dashboard/developers) adds street-level photos to "open photos nearby".
# MAPILLARY_TOKEN=MLY|...

# Place search (Route tab) — default is the public Nominatim: development only
# RASTA_GEOCODER_URL=https://nominatim.example.org
# RASTA_GEOCODER_COUNTRY=in
